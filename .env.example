# ============================================================
# AI 智能客服平台环境变量模板
# 使用：cp .env.example .env，然后填入密钥（.env 已被 git 忽略）
# ============================================================

# —— Qdrant Cloud（向量库存储，免费层：0.5 vCPU / 1GB / 4GB，无需信用卡）——
# 注册与开集群: https://cloud.qdrant.io
#   1. Create Cluster → 选 Free
#   2. 集群详情页复制 Endpoint（形如 https://xxxx.aws.cloud.qdrant.io）
#   3. API Keys 页面创建并复制 Key
QDRANT_URL=
QDRANT_API_KEY=

# —— 硅基流动（Embedding + Rerank，bge-m3 / bge-reranker-v2-m3 免费档）——
# 注册与建密钥: https://cloud.siliconflow.cn/account/ak
# 模型 ID 已在代码中固定为 BAAI/bge-m3（1024 维）与 BAAI/bge-reranker-v2-m3，
# 两者免费；不要换用带 Pro/ 前缀的版本（收费）。
SILICONFLOW_API_KEY=

# —— 飞书知识库连接器（可选：企业文档源）——
# 注册入口: https://open.feishu.cn/app 创建「企业自建应用」
#   1. 开通权限：wiki:wiki:readonly（知识库读）+ docx:document:readonly（文档读）
#   2. 应用发布版本，并把知识库所在空间的成员加入应用「可用范围」
#   3. 填入下方两个值后：npm run kb -- feishu（列出空间）→ npm run kb -- feishu <space_id>
#FEISHU_APP_ID=
#FEISHU_APP_SECRET=
# 私有化飞书才需要（默认 https://open.feishu.cn）
#FEISHU_BASE_URL=

# —— 智能体规划器 LLM（ADR-0006，可选：不配则用 Rule 规划器降级）——
# 任何 OpenAI 兼容端点均可：硅基流动 / new-api / llm-proxy。
# 默认用硅基流动的 Qwen2.5-7B-Instruct（免费档，非 Pro/ 前缀）；
# LLM_API_KEY 不填时自动复用上面的 SILICONFLOW_API_KEY。
#LLM_BASE_URL=https://api.siliconflow.cn/v1
#LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#LLM_API_KEY=
# 单轮最大「规划→行动」循环步数（防工具死循环）
#AGENT_MAX_STEPS=4
# FAQ 直达智能体的分数下限：低于此分的 FAQ 命中放行给智能体（低分硬答是事故）
#FAQ_DIRECT_MIN_SCORE=0.8
# FAQ 工具意图闸门：带订单号/工单/投诉/物流/优惠券等信号的问题不走 FAQ 直达，
# 交给智能体（否则 MCP / Skills 永远没机会被调用）。置 false 恢复旧行为。
#FAQ_TOOL_GUARD=true

# —— 可选项（不填走默认值）——
# CLI 入库默认命名空间
# KB_NAMESPACE=personal
# 网关机器人检索的命名空间（读你入的个人资料）
# KB_ANSWER_NAMESPACE=personal
# 检索阈值：低于下限宁可走兜底，也不硬答
# KB_MIN_VECTOR_SCORE=0.35
# KB_MIN_RERANK_SCORE=0.25

# —— 技能 Skills（ADR-0007，可选：命中后注入领域指令，不限制工具权限）——
#SKILLS_ENABLED=true

# —— MCP 外部工具（ADR-0007，可选：stdio 传输，JSON 数组）——
# 与 Claude/Codex 的 mcp.json 里 mcpServers 条目同构，支持 command/args/env/cwd/timeout。
# 例（文件系统 server）：
#MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# 内置演示 server（logistics_track / coupon_status），用来验证闭环；生产环境置 false
#MCP_DEMO_SERVER=true
#MCP_ENABLED=true
#MCP_TIMEOUT_SECONDS=20

# —— 路由分诊 Router（ADR-0008，可选：按业务域隔离坐席与工具白名单）——
# 关掉则退回单坐席：所有工具可见、无白名单，行为与加路由之前一致
#AGENT_ROUTING_ENABLED=true
# 规则路由的分数下限：命中一个触发词记 1 分，命中订单/运单号每个 +2
#ROUTER_MIN_SCORE=1.0
# 分诊模型：留空复用 LLM_MODEL。分类是短任务，可换更小更快的模型
#ROUTER_MODEL=
# 分诊超时（秒）：超时退回规则最高分，不阻塞主链路
#ROUTER_TIMEOUT_SECONDS=4
# 多轮追问无关键词时沿用上一轮坐席（兜底坐席不参与沿用）
#ROUTER_CARRY_OVER=true

# —— 反馈闭环 / 数据面（ADR-0009，可选）——
# 对话与评价落盘的目录，默认仓库根 var/data（JSONL 追加写，落盘即脱敏）
# 容器部署时挂卷到这里：-v /data/cs:/app/var/data
#DATA_DIR=./var/data
# 关掉则网关不再落盘（只影响数据采集，不影响对话与评价接口的返回）
#TRACE_STORE_ENABLED=false

# —— 入口防护（ADR-0010，私有化必配）——
# 管理面 token：导出对话 / 看板 / 评测集都要它。
# 不配则管理面只允许本机访问（127.0.0.1），远程一律 403。
# 生成：openssl rand -hex 24
#ADMIN_TOKEN=
# 挂件来源白名单，逗号分隔，写完整 origin。留空 = 不校验（仅本地联调）。
# 上线不填，端点可被同行当免费 API 爬知识库。网关自身地址也要写进去。
#WIDGET_ORIGINS=https://shop.example.com,http://10.0.0.12:8787
# 单 IP 每分钟对话次数，0 = 关闭。防单实例被打满，不是防刷钱。
#RATE_LIMIT_PER_MINUTE=30
# 只有确实在 nginx / 负载均衡后面才开，否则 X-Forwarded-For 可伪造
#TRUST_PROXY=1

# —— 模型端点拆分（私有化核心：三者常常不在同一家）——
# 留空则回退到 SILICONFLOW_*，云上部署零改动。
# Embedding：内网 TEI / 自建网关（需 OpenAI 兼容 /embeddings）
#EMBEDDING_BASE_URL=http://tei.internal:8080/v1
#EMBEDDING_API_KEY=
#EMBEDDING_MODEL=BAAI/bge-m3
#EMBEDDING_DIMENSIONS=1024
# Rerank：留空继承 Embedding 地址；客户不提供则退化为向量序，不报错
#RERANK_BASE_URL=
#RERANK_API_KEY=
