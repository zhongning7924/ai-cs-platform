# ============================================================
# AI 智能客服平台环境变量模板
# 使用：cp .env.example .env，然后填入密钥（.env 已被 git 忽略）
# ============================================================

# —— Qdrant Cloud（向量库存储，免费层：0.5 vCPU / 1GB / 4GB，无需信用卡）——
# 注册与开集群: https://cloud.qdrant.io
#   1. Create Cluster → 选 Free
#   2. 集群详情页复制 Endpoint（形如 https://xxxx.aws.cloud.qdrant.io）
#   3. API Keys 页面创建并复制 Key
QDRANT_URL=
QDRANT_API_KEY=

# —— 硅基流动（Embedding + Rerank，bge-m3 / bge-reranker-v2-m3 免费档）——
# 注册与建密钥: https://cloud.siliconflow.cn/account/ak
# 模型 ID 已在代码中固定为 BAAI/bge-m3（1024 维）与 BAAI/bge-reranker-v2-m3，
# 两者免费；不要换用带 Pro/ 前缀的版本（收费）。
SILICONFLOW_API_KEY=

# —— 飞书知识库连接器（可选：企业文档源）——
# 注册入口: https://open.feishu.cn/app 创建「企业自建应用」
#   1. 开通权限：wiki:wiki:readonly（知识库读）+ docx:document:readonly（文档读）
#   2. 应用发布版本，并把知识库所在空间的成员加入应用「可用范围」
#   3. 填入下方两个值后：npm run kb -- feishu（列出空间）→ npm run kb -- feishu <space_id>
#FEISHU_APP_ID=
#FEISHU_APP_SECRET=
# 私有化飞书才需要（默认 https://open.feishu.cn）
#FEISHU_BASE_URL=

# —— 智能体规划器 LLM（ADR-0006，可选：不配则用 Rule 规划器降级）——
# 任何 OpenAI 兼容端点均可：硅基流动 / new-api / llm-proxy。
# 默认用硅基流动的 Qwen2.5-7B-Instruct（免费档，非 Pro/ 前缀）；
# LLM_API_KEY 不填时自动复用上面的 SILICONFLOW_API_KEY。
#LLM_BASE_URL=https://api.siliconflow.cn/v1
#LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#LLM_API_KEY=
# 单轮最大「规划→行动」循环步数（防工具死循环）
#AGENT_MAX_STEPS=4
# FAQ 直达智能体的分数下限：低于此分的 FAQ 命中放行给智能体（低分硬答是事故）
#FAQ_DIRECT_MIN_SCORE=0.8
# FAQ 工具意图闸门：带订单号/工单/投诉/物流/优惠券等信号的问题不走 FAQ 直达，
# 交给智能体（否则 MCP / Skills 永远没机会被调用）。置 false 恢复旧行为。
#FAQ_TOOL_GUARD=true

# —— 可选项（不填走默认值）——
# CLI 入库默认命名空间
# KB_NAMESPACE=personal
# 网关机器人检索的命名空间（读你入的个人资料）
# KB_ANSWER_NAMESPACE=personal
# 检索阈值：低于下限宁可走兜底，也不硬答
# KB_MIN_VECTOR_SCORE=0.35
# KB_MIN_RERANK_SCORE=0.25

# —— 技能 Skills（ADR-0007，可选：命中后注入领域指令，不限制工具权限）——
#SKILLS_ENABLED=true

# —— MCP 外部工具（ADR-0007，可选：stdio 传输，JSON 数组）——
# 与 Claude/Codex 的 mcp.json 里 mcpServers 条目同构，支持 command/args/env/cwd/timeout。
# 例（文件系统 server）：
#MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# 内置演示 server（logistics_track / coupon_status），用来验证闭环；生产环境置 false
#MCP_DEMO_SERVER=true
#MCP_ENABLED=true
#MCP_TIMEOUT_SECONDS=20
