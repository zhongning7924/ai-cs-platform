# ============================================================
# 私有化部署配置模板
#
# 用法：cp deploy/.env.private.example deploy/.env  然后逐项填
# deploy/.env 已在 .gitignore 里，**不要提交**。
# ============================================================

# —— 对外端口 ——
CS_PORT=8787

# —— 1. LLM（必填）——
# 任意 OpenAI 兼容网关：vLLM / One-API / 集团统一 AI 平台都可以，
# 只要支持 /chat/completions 和流式（stream=true）。
LLM_BASE_URL=http://llm-gateway.internal/v1
LLM_API_KEY=sk-please-change
LLM_MODEL=Qwen2.5-7B-Instruct
# 分诊用的模型。分类是短任务，可以填更小更快的；留空复用 LLM_MODEL
ROUTER_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# —— 2. Embedding（必填）——
# 需要 OpenAI 兼容的 /embeddings。维度必须和模型一致，否则建集合就错。
EMBEDDING_BASE_URL=http://tei.internal:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# —— 3. Rerank（可选）——
# 留空则继承 Embedding 的地址和 key。客户只提供 embedding 时，
# 检索会退化为「向量序」，效果下降但不会报错。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# —— 4. 向量库 ——
# 不填则用 compose 里的本地 qdrant（推荐，内网环境不需要再申请外部资源）。
# 客户已有 Qdrant 时填下面两项，并把 compose 里的 qdrant 服务删掉。
#QDRANT_URL=http://qdrant.internal:6333
#QDRANT_API_KEY=

# —— 5. 知识库 ——
# namespace 用来区分「正式库 / 测试库」，不承担租户隔离（单商户单实例）
KB_NAMESPACE=prod
KB_MIN_VECTOR_SCORE=0.35
KB_MIN_RERANK_SCORE=0.25

# —— 6. 安全（上线必须配，否则管理面导出接口裸奔）——
# 管理面 token：/api/dataset/export、/api/traces、/api/stats/feedback 都要它。
# 生成方式：openssl rand -hex 24
ADMIN_TOKEN=please-change-to-a-random-string

# 挂件来源白名单，逗号分隔，写完整 origin（含协议和端口）。
# 留空 = 不校验（只适合本地联调）。上线不填，同行可以直接拿你的接口爬知识库。
WIDGET_ORIGINS=https://shop.example.com

# 单 IP 每分钟对话次数，0 = 关闭。
# 目的不是省钱（key 是客户自己的），是防单实例被打满导致全站客服挂掉。
RATE_LIMIT_PER_MINUTE=30

# 只有确实在 nginx / 负载均衡后面才打开，否则 X-Forwarded-For 可伪造，限流形同虚设
#TRUST_PROXY=1

# —— 7. 运行数据 ——
TRACE_STORE_ENABLED=true

# —— 8. 演示用 MCP server（生产必须关）——
# 它提供的是假物流/假优惠券数据。开着它，模型可能拿假数据回答真客户。
MCP_DEMO_SERVER=false
